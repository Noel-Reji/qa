"""Environment configuration file."""

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_REASONING_MODEL=gpt-4-turbo-preview
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_FAST_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Retrieval Configuration
RETRIEVAL_CHUNK_SIZE=512
RETRIEVAL_CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=5
RETRIEVAL_USE_BM25=true
RETRIEVAL_USE_DENSE=true
RETRIEVAL_USE_RERANKER=true
RETRIEVAL_INDEX_TYPE=faiss

# Parsing Configuration
PARSING_MAX_FILE_SIZE_MB=100
PARSING_ENABLE_OCR=false
PARSING_ENABLE_HIERARCHICAL_PARSING=true

# SQL Configuration
SQL_ENGINE_TYPE=duckdb
SQL_DB_PATH=data/qa_engine.db
SQL_ENABLE_QUERY_OPTIMIZATION=true

# Reasoning Configuration
REASONING_MAX_REASONING_STEPS=10
REASONING_ENABLE_CONFIDENCE_SCORING=true
REASONING_CONFIDENCE_THRESHOLD=0.6
REASONING_HALLUCINATION_CHECK=true
REASONING_REQUIRE_EVIDENCE=true

# Evaluation Configuration
EVALUATION_TRACK_ACCURACY=true
EVALUATION_TRACK_LATENCY=true
EVALUATION_TRACK_COST=true

# Logging Configuration
LOGGING_LOG_LEVEL=INFO
LOGGING_LOG_DIR=logs
LOGGING_ENABLE_FILE_LOGGING=true
LOGGING_ENABLE_JSON_LOGGING=true

# System Configuration
ENVIRONMENT=development
DEBUG=false
BATCH_SIZE=32
ENABLE_CACHE=true
